# ==========================================
# Backend Configuration
# ==========================================
# Đường dẫn hoặc tên file weights mô hình YOLO (ví dụ: yolov8n.pt, yolov8s.pt, weights/best.pt)
MODEL_PATH=yolov8n.pt

# Ngưỡng tin cậy nhận diện (giá trị từ 0.0 đến 1.0)
CONFIDENCE_THRESHOLD=0.25

# Giới hạn dung lượng file upload (đơn vị: MB)
MAX_FILE_SIZE_MB=50

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
# URL gốc của Backend API mà Frontend sẽ gọi tới
VITE_API_BASE_URL=http://localhost:8000
